// PortaGast backend — Prisma schema
// Data model for the applicant intake flow with GDPR-aware consent,
// minimization, retention and audit fields.

generator client {
  provider = "prisma-client-js"
  // Erlaubt `relationLoadStrategy: "join"`: verschachtelte `include`s werden
  // dann als EIN SQL-Statement mit LATERAL JOINs ausgeführt statt als eine
  // Abfrage je Ebene. Auf der Free-Instanz kostet jede Ebene rund 113 ms.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  // Runtime-Verbindung. Bei Supabase: der Connection-Pooler (Port 6543).
  url       = env("DATABASE_URL")
  // Direkte Verbindung für Migrationen. Bei Supabase: Direct connection (Port 5432).
  // Lokal darf DIRECT_URL identisch zu DATABASE_URL sein.
  directUrl = env("DIRECT_URL")
}

// ── Verification challenges (OTP) ───────────────────────────────────────────
// Codes are never stored in plaintext — only an HMAC hash is persisted.
// The (contact, purpose) unique constraint serializes concurrent requests and
// guarantees a single active challenge per contact (see OtpService).
model OtpChallenge {
  id          String        @id @default(uuid())
  // Normalized contact (lowercased email or E.164 phone).
  contact     String
  channel     OtpChannel
  purpose     OtpPurpose    @default(REGISTRATION)
  // HMAC-SHA256 hash of the code (never the code itself).
  codeHash    String
  attempts    Int           @default(0)
  maxAttempts Int
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime      @default(now())

  @@unique([contact, purpose])
  @@index([expiresAt])
}

enum OtpChannel {
  EMAIL
  SMS
}

enum OtpPurpose {
  REGISTRATION
}

// ── OTP issuance log ─────────────────────────────────────────────────────────
// Records only a keyed HASH of the contact so a rolling issuance cap can be
// enforced (anti SMS-pumping / bombing) without persisting raw contact data.
// Cleaned up by the retention job.
model OtpIssuance {
  id          String     @id @default(uuid())
  contactHash String
  channel     OtpChannel
  createdAt   DateTime   @default(now())

  @@index([contactHash, createdAt])
  @@index([createdAt])
}

// ── Single-use verification tokens ──────────────────────────────────────────
// A successful OTP mints a signed token carrying a random `jti`. The jti is
// consumed here on first application submission; the unique PK makes replay
// attempts fail atomically. Cleaned up after expiry by the retention job.
model UsedVerificationToken {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ── Applications ─────────────────────────────────────────────────────────────
model Application {
  id            String             @id @default(uuid())

  // Personal data (PII).
  firstName     String
  lastName      String
  // Data minimization: only the birth YEAR is retained; the full date is used
  // transiently for the age check at submission and then discarded.
  birthYear     Int?
  ageVerified   Boolean            @default(false)
  email         String
  phone         String

  // Search preferences.
  profession    String?
  federalState  String?
  availability  String?

  // Verification state — set only after a successful OTP check.
  verified      Boolean            @default(false)
  verifiedVia   OtpChannel?
  verifiedAt    DateTime?

  // Applicant's self-reported search intensity (post-submit question).
  searchIntent  SearchIntent?

  // GDPR consent captured at submission time.
  consentAt     DateTime?
  // Exact wording the frontend displayed + its version, for Art. 7(1) proof.
  consentText   String?
  consentVersion String?
  // Separate, withdrawable consent for the optional profile photo.
  consentPhoto  Boolean            @default(false)

  status        ApplicationStatus  @default(SUBMITTED)

  documents     Document[]

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  // Point in time after which the record is eligible for automated erasure.
  retentionUntil DateTime?
  // Excludes the record from automated erasure (e.g. pending AGG claim).
  legalHold     Boolean            @default(false)
  // Set when a data-subject / operator erasure was requested but object
  // deletion has not yet fully succeeded (retry via the retention job).
  erasureRequestedAt DateTime?
  // Set only once the record is fully anonymized AND all objects are gone.
  erasedAt      DateTime?

  @@index([email])
  @@index([status])
  @@index([retentionUntil])
  @@index([erasureRequestedAt])
  @@index([erasedAt, createdAt(sort: Desc)])
}

enum ApplicationStatus {
  SUBMITTED
  IN_REVIEW
  MATCHED
  ARCHIVED
  ERASED
}

enum SearchIntent {
  ACTIVE
  PASSIVE
}

// ── Documents (files in object storage) ─────────────────────────────────────
// Only metadata lives in the DB. Binary content is stored in a private,
// encrypted S3 bucket keyed by `storageKey`.
model Document {
  id            String        @id @default(uuid())
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  type          DocumentType
  // Opaque, randomized object key. Never derived from user input.
  storageKey    String        @unique
  // Original filename, sanitized. Kept for display only.
  originalName  String
  mimeType      String
  sizeBytes     Int
  // SHA-256 checksum of the stored bytes (integrity + dedupe).
  checksum      String
  createdAt     DateTime      @default(now())

  @@index([applicationId])
}

enum DocumentType {
  PHOTO
  CV
  QUALIFICATION
}

// ── Audit log ────────────────────────────────────────────────────────────────
// Append-only trail of privileged / security-relevant actions.
// Never stores raw PII — actor IPs are stored as a keyed (pseudonymizing) hash;
// see the IP-hashing LIA. Retention-limited by the retention job.
model AuditEvent {
  id          String   @id @default(uuid())
  action      String
  entityType  String?
  entityId    String?
  // Optional actor attribution (e.g. admin key id). Never a raw secret.
  actorId     String?
  // Keyed hash of the request IP (not the raw address).
  actorIpHash String?
  // Convention: metadata MUST NOT contain raw PII.
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  // Sicherheits-Screen filtert nach Akteur und sortiert nach Zeit.
  @@index([actorId, createdAt(sort: Desc)])
}

// ── User accounts (registration + login) ────────────────────────────────────
// Email + password login. Passwords are stored only as a scrypt hash
// (algo$params$salt$hash) — never in plaintext. `tokenVersion` is embedded in
// issued JWTs and bumped on logout / password reset to invalidate old tokens.
model User {
  id           String     @id @default(uuid())
  // Normalized (lowercased) email — the unique login identifier.
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String
  // Account type. APPLICANT = self-registered Handwerker; EMPLOYER = company
  // account, provisioned manually after an email contact + signed contract.
  role         UserRole   @default(APPLICANT)
  // Only set for EMPLOYER accounts (legacy display name; see `company`).
  companyName  String?
  // ── Zustimmung zu Nutzungsbedingungen und Datenschutzerklärung ──────────
  // Ohne Nachweis ist eine Zustimmung im Streitfall wertlos: Es muss belegbar
  // sein, WANN und WELCHEM Textstand jemand zugestimmt hat. Die Häkchen im
  // Formular allein reichen dafür nicht — sie verschwinden mit dem Browser.
  agbAcceptedAt      DateTime?
  agbVersion         String?
  datenschutzAcceptedAt DateTime?
  datenschutzVersion    String?

  // EMPLOYER accounts belong to exactly one company.
  company      Company?   @relation(fields: [companyId], references: [id])
  companyId    String?
  // Optional referral: the name/code the applicant entered ("Empfohlen von").
  referredBy   String?
  // All onboarding answers (survey step 1 + AI profile step 4 + work locations),
  // copied from the registration draft on completion so everything the user
  // filled in is queryable per-user later. Shape is opaque.
  profileData  Json?
  // Contact-verification status. Set true after a successful OTP check.
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  // Optional profile / reference picture, stored as a small resized data URL
  // (base64). Kept in the DB to avoid an object-storage dependency for avatars.
  avatar       String?   @db.Text
  status       UserStatus @default(ACTIVE)
  // Stateless-JWT revocation counter. A JWT is only accepted while its `ver`
  // claim matches this value.
  tokenVersion Int        @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  passwordResets  PasswordReset[]
  jobApplications JobApplication[]
  jobOffers       JobOffer[]
  contactRequests ContactRequest[]
  favorites       Favorite[]

  // Kandidatensuche filtert auf aktive Bewerber; companyId ist ein
  // Fremdschlüssel ohne eigenen Index (Löschprüfungen, Firmen-Zuordnung).
  @@index([role, status])
  @@index([companyId])
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum UserRole {
  APPLICANT
  EMPLOYER
}

// ── Companies (employer organizations) ──────────────────────────────────────
// A company is the unit that owns job postings and contact requests. EMPLOYER
// users link to exactly one company. `source` records WHO created the record:
// SELF (the company itself), ADMIN (our staff) or AI (automated intake after a
// phone acquisition) — companies never need to touch the platform themselves.
model Company {
  id             String        @id @default(uuid())
  name           String
  // Short sentence shown directly under the name in offers.
  slogan         String        @default("")
  // Long-form "Über uns" description.
  description    String        @default("") @db.Text
  gruendungsjahr String        @default("")
  mitarbeiter    String        @default("")
  strasse        String        @default("")
  plz            String        @default("")
  ort            String        @default("")
  // Coarse coordinates for maps/distance (city-level, never an address pin).
  lat            Float?
  lng            Float?
  website        String        @default("")
  // Contact person shown in offers (builds trust).
  kontaktName     String       @default("")
  kontaktPosition String       @default("")
  kontaktTelefon  String       @default("")
  kontaktEmail    String       @default("")
  // Benefits shown as chips; montage is the single most decisive criterion.
  benefits       String[]      @default([])
  montage        String        @default("")
  urlaubstage    Int?
  // Logo as a small data URL (same approach as User.avatar).
  logo           String?       @db.Text
  source         CompanySource @default(SELF)
  // Internal note for ADMIN/AI-created records (e.g. "telefonisch akquiriert").
  managedNote    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  users           User[]
  jobPostings     JobPosting[]
  contactRequests ContactRequest[]
}

enum CompanySource {
  SELF
  ADMIN
  AI
}

// ── Match questions (catalog) ───────────────────────────────────────────────
// The questions a Handwerker answers during onboarding, made matchable: each
// row defines the numeric scale and HOW the worker's numeric value is derived
// from User.profileData (answerKey + optional valueMap). Employers answer the
// same questions per job posting via JobCriterion (range + weight).
// ── Job postings ────────────────────────────────────────────────────────────
model JobPosting {
  id          String        @id @default(uuid())
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId   String
  title       String
  // Exact GEWERKE value — the bridge to worker profiles.
  gewerk      String
  description String        @default("") @db.Text
  tags        String[]      @default([])
  city        String        @default("")
  lat         Float?
  lng         Float?
  // Gross monthly salary band in euros.
  salaryMin   Int?
  salaryMax   Int?
  // Conditions that decide acceptance in the trades.
  montage                String  @default("")
  fahrzeitIstArbeitszeit Boolean @default(false)
  startpunkt             String  @default("Betrieb")
  urlaubstage            Int?
  startText              String  @default("Ab sofort")
  extras                 String[] @default([])
  // ── Anforderungsprofil (Matching) ──────────────────────────────────────
  // Werte stammen aus `src/matching/catalog.ts`. Leer bzw. null heißt
  // durchgehend: dem Betrieb ist das egal — das Kriterium wird dann weder
  // geprüft noch gewertet.
  bereiche          String[] @default([])   // akzeptierte Ausbildungsbereiche (Ausschluss)
  berufe            String[] @default([])   // bevorzugte Ausbildungsberufe (gewichtet)
  ausbildungMin     String?                 // Mindest-Ausbildungsstand (Ausschluss)
  aufgaben          String[] @default([])   // gesuchte Aufgabenbereiche
  // Wie viele der gesuchten Aufgabenbereiche der Handwerker mindestens
  // abdecken MUSS. 0 = keine Pflicht, die Bereiche zählen dann nur Punkte.
  aufgabenMin       Int      @default(0)
  erfahrungMin      String?
  erfahrungMax      String?
  montageMin        String?                 // verlangte Montagebereitschaft (Ausschluss)
  fuehrerscheinMin  String?                 // verlangter Führerschein
  deutschMin        String?                 // verlangtes Sprachniveau (Ausschluss)
  gebotenes         String[] @default([])   // trifft auf die Prioritäten des Handwerkers
  startBis          String?                 // bis wann besetzt werden soll
  // Abweichende Gewichte je Kriterium (0–5); fehlt ein Wert, gilt die Vorgabe.
  gewichte          Json?

  status      JobStatus     @default(ACTIVE)
  // Who created the posting (same semantics as Company.source).
  source      CompanySource @default(SELF)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  offers       JobOffer[]
  applications JobApplication[]
  favorites    Favorite[]

  @@index([companyId])
  @@index([status, gewerk])
  // Jobbörse: status-Filter + Sortierung nach Alter; Arbeitgeberliste je Firma.
  @@index([status, createdAt(sort: Desc)])
  @@index([companyId, status, createdAt(sort: Desc)])
}

enum JobStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

// ── Applications of a worker to a posting ───────────────────────────────────
model JobApplication {
  id           String               @id @default(uuid())
  jobPosting   JobPosting           @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  jobPostingId String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  status       JobApplicationStatus @default(SENT)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([jobPostingId, userId])
  @@index([userId])
  @@index([userId, updatedAt(sort: Desc)])
}

enum JobApplicationStatus {
  SENT
  SEEN
  INTERVIEW
  REJECTED
  ACCEPTED
}

// ── Offers (a company actively offers a posting to a worker) ────────────────
model JobOffer {
  id            String         @id @default(uuid())
  jobPosting    JobPosting     @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  jobPostingId  String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  message       String         @default("") @db.Text
  contactPerson String         @default("")
  status        JobOfferStatus @default(NEW)
  // Why the worker declined — feeds back into matching later.
  declineReason String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([jobPostingId, userId])
  @@index([userId])
}

enum JobOfferStatus {
  NEW
  ACCEPTED
  DECLINED
}

// ── Favorites (worker bookmarks a posting) ──────────────────────────────────
model Favorite {
  id           String     @id @default(uuid())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  jobPostingId String
  createdAt    DateTime   @default(now())

  @@unique([userId, jobPostingId])
}

// ── Contact requests (employer asks a candidate to reveal contact data) ─────
// The company NEVER receives contact data until the worker approves. Until
// then only the pseudonymous profile is visible.
model ContactRequest {
  id        String               @id @default(uuid())
  company   Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  // Position the request refers to (free text, shown to the worker).
  position  String
  status    ContactRequestStatus @default(REQUESTED)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId, createdAt(sort: Desc)])
}

enum ContactRequestStatus {
  REQUESTED
  APPROVED
  DECLINED
}

// ── Registration wizard drafts ──────────────────────────────────────────────
// Holds progress through the multi-step onboarding BEFORE an account exists.
// Steps 1–5 are PLACEHOLDERS — their fields are not defined yet, so their
// payloads are captured opaquely in `stepData`. The final contact step
// (firstName/lastName/email/phone + password) promotes the draft into a User.
// Pruned by the retention job once completed or expired.
model RegistrationDraft {
  id          String    @id @default(uuid())
  // Highest wizard step reached (0 = just started, 6 = contact captured).
  currentStep Int       @default(0)
  // Per-step payloads keyed by step number ("1".."5"). Opaque until the flow
  // is finalized. MUST NOT be relied on for anything security-relevant.
  stepData    Json      @default("{}")
  // Set once the draft has been promoted to a User (single-use).
  completedAt DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([expiresAt])
}

// ── Referral partners (affiliate program) ───────────────────────────────────
// A partner signs up (phone + password, SMS-verified) and gets a personal
// referral link portawerk.de/r/<slug>. When a Handwerker registers via that
// link and is successfully placed into a job, the partner earns a fixed reward.
model Partner {
  id            String     @id @default(uuid())
  name          String
  // Chosen, unique referral slug used in the public link (portawerk.de/r/<slug>).
  slug          String     @unique
  // E.164 phone — the login identifier + SMS-verification target.
  phone         String     @unique
  email         String?
  passwordHash  String
  status        UserStatus @default(ACTIVE)
  // Partners are provisioned only after an SMS check, so they start verified.
  phoneVerified Boolean    @default(true)
  // Optional payout details the partner enters to receive their reward.
  payoutIban    String?
  payoutHolder  String?
  // Stateless-JWT revocation counter (same mechanism as User).
  tokenVersion  Int        @default(0)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  referrals     Referral[]
}

// ── Referrals (a person the partner brought in) ─────────────────────────────
// Created when a Handwerker registers with ?ref=<slug>. Tracks the placement
// lifecycle + the reward. A candidate snapshot (first name + trade) is stored
// so the dashboard can show progress without exposing full applicant PII.
model Referral {
  id             String         @id @default(uuid())
  partner        Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId      String
  // The registered applicant account, if linked (one referral per user).
  referredUserId String?        @unique
  // Display snapshot for the partner dashboard (e.g. "Thomas M." + "Elektriker").
  candidateName  String?
  candidateTrade String?
  status         ReferralStatus @default(REGISTERED)
  // Reward in euro cents; set when the placement succeeds.
  rewardCents    Int            @default(0)
  placedAt       DateTime?
  paidAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([partnerId])
  @@index([status])
  @@index([status, partnerId])
}

enum ReferralStatus {
  REGISTERED // geworben — signed up via the link
  IN_PLACEMENT // vermittlung — in an active placement process
  PLACED // vermittelt — successfully placed (reward earned)
  PAID // ausgezahlt — reward paid out
}

// ── Referral link clicks ────────────────────────────────────────────────────
// Lightweight click counter for the /r/<slug> redirect. Stores only a keyed
// hash of the IP (dedupe/anti-abuse), never the raw address. Retention-pruned.
model ReferralClick {
  id        String   @id @default(uuid())
  slug      String
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([slug])
  @@index([createdAt])
}

// ── Password reset challenges ───────────────────────────────────────────────
// A reset request mints a single-use, high-entropy token; only its SHA-256
// hash is persisted (the token is 256-bit random, so an unkeyed hash is
// sufficient — no pepper needed, unlike the low-entropy OTP codes).
model PasswordReset {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}
