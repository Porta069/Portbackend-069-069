# ─────────────────────────────────────────────────────────────────────────────
# PortaGast Backend — Environment configuration
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# All variables are validated at boot (src/config/env.validation.ts).
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public base URL of this API (used in logs / links). No trailing slash.
APP_URL=http://localhost:4000
# Number of trusted reverse-proxy hops in front of the app (0 if exposed
# directly). Governs how req.ip is derived — critical for rate limiting.
# Set to the REAL topology in production; a wrong value breaks abuse controls.
TRUST_PROXY_HOPS=1

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowlist of frontend origins. Wildcards are NOT allowed.
CORS_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Use a least-privilege application role, NOT a superuser.
# In PRODUCTION the URL must enforce TLS, e.g. append ?sslmode=require
#
# Supabase: nutze den Connection-Pooler (Port 6543) für DATABASE_URL und die
# direkte Verbindung (Port 5432) für DIRECT_URL — beide unter
# Supabase → Project Settings → Database → Connection string.
DATABASE_URL=postgresql://portagast:portagast@localhost:5432/portagast?schema=public
# Direkte Verbindung für Prisma-Migrationen. Lokal = DATABASE_URL.
# Supabase-Beispiel:
#   DATABASE_URL=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10
#   DIRECT_URL=postgresql://postgres.<ref>:<pw>@db.<ref>.supabase.co:5432/postgres
DIRECT_URL=postgresql://portagast:portagast@localhost:5432/portagast?schema=public

# ── Security secrets (generate EACH with: openssl rand -hex 32) ─────────────
# Separate secret per cryptographic purpose (key separation). Min 32 chars each.
# HMAC pepper for OTP code hashes.
OTP_HASHING_SECRET=change-me-to-a-64-char-hex-string-generated-with-openssl-rand
# HMAC signing key for the stateless verification token.
VERIFICATION_TOKEN_SECRET=change-me-to-a-different-64-char-hex-string
# Pepper for hashing audit-log IP addresses.
AUDIT_IP_PEPPER=change-me-to-a-third-64-char-hex-string
# Admin API key protecting privileged endpoints (application retrieval/export).
# Server-to-server only — never expose to a browser. Rotate periodically.
ADMIN_API_KEY=change-me-to-a-long-random-admin-api-key-min-32-chars
# HMAC signing key for stateless access JWTs + registration-draft tokens.
AUTH_JWT_SECRET=change-me-to-a-fourth-64-char-hex-string-generated-with-openssl

# ── Auth (registration + login) ──────────────────────────────────────────────
# Access-token lifetime in seconds (short-lived; client re-authenticates).
AUTH_JWT_TTL_SECONDS=3600
# How long an incomplete registration wizard draft stays resumable.
AUTH_REGISTRATION_DRAFT_TTL_SECONDS=3600
# Password-reset token lifetime in seconds.
AUTH_PASSWORD_RESET_TTL_SECONDS=900
# Frontend URL the reset link points to (the token is appended as ?token=...).
AUTH_PASSWORD_RESET_URL=http://localhost:3000/reset-password

# ── OTP policy ───────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Rolling issuance caps per contact (anti SMS/email bombing & toll fraud).
OTP_MAX_PER_HOUR=3
OTP_MAX_PER_DAY=10

# ── Email provider (Resend) ─────────────────────────────────────────────────
# Leave EMAIL_PROVIDER=console in dev to print codes to the log instead of sending.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="PortaGast <noreply@portagast.example>"

# ── SMS provider (Twilio) ────────────────────────────────────────────────────
# Leave SMS_PROVIDER=console in dev to print codes to the log instead of sending.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Only deliver SMS to these country prefixes (anti international pumping fraud).
SMS_ALLOWED_COUNTRY_PREFIXES=+49,+43,+41

# ── Object storage (S3-compatible) ──────────────────────────────────────────
# For local dev use MinIO (see docker-compose.yml).
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=portagast-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Required for MinIO / path-style S3 endpoints.
S3_FORCE_PATH_STYLE=true
# Server-side encryption for objects at rest: AES256 or aws:kms.
S3_SERVER_SIDE_ENCRYPTION=AES256
# Optional KMS key id when using aws:kms.
S3_KMS_KEY_ID=

# ── Uploads policy ───────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760
# Max number of files per submission (cv + photo + qualifications).
MAX_UPLOAD_FILES=8

# ── Data retention (GDPR) ────────────────────────────────────────────────────
# Days to keep an application before it becomes eligible for automated erasure.
# 180d is a defensible default for DE applicant data (AGG claim window + buffer).
APPLICATION_RETENTION_DAYS=180
# Days to keep audit-log events before automated pruning.
AUDIT_RETENTION_DAYS=365
