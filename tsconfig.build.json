{
  "extends": "./tsconfig.json",
  // rootDir festnageln: gerät eine .ts-Datei ausserhalb von src/ in den Build,
  // verschiebt sich sonst still dist/main.js — der Start-Befehl findet es dann
  // nicht mehr und der Deploy bricht erst zur Laufzeit ab.
  "compilerOptions": { "rootDir": "src" },
  "exclude": ["node_modules", "test", "dist", "scripts", "**/*spec.ts"]
}
